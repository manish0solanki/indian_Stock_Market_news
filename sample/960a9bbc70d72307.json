{"key":"GET fzazdrzlemmkqngvpzxj.supabase.co/functions/v1/stock-signal-data?symbol=ULTRACEMCO","page":"/stock-analysis.html","status":200,"type":"application/json","body":"{\"success\":true,\"symbol\":\"ULTRACEMCO\",\"yahoo_symbol\":\"ULTRACEMCO.NS\",\"company_name\":\"UltraTech Cement Limited\",\"exchange\":\"NSI\",\"currency\":\"INR\",\"price\":11816,\"previous_close\":11700,\"previous_close_source\":\"yahoo quote\",\"change\":116,\"change_percent\":0.9914529914529915,\"open\":11618,\"high\":11830,\"low\":11600,\"volume\":273118,\"high_52w\":13110,\"low_52w\":10325,\"fundamentals\":{\"market_cap\":3474667339776,\"pe\":40.599228,\"forward_pe\":28.703127,\"peg_ratio\":1.22,\"price_to_book\":4.723447,\"book_value\":2501.563,\"eps\":291.04,\"dividend_yield\":0.020499999,\"dividend_rate\":240,\"beta\":0.462,\"profit_margin\":0.092089996,\"operating_margin\":0.107659996,\"return_on_equity\":0.114980005,\"return_on_assets\":0.05953,\"revenue\":955724201984,\"revenue_per_share\":3249.078,\"earnings_growth\":0.213,\"revenue_growth\":0.188,\"gross_profit\":555074191360,\"free_cash_flow\":12882762752,\"total_cash\":41260101632,\"total_debt\":292893097984,\"sector\":\"Basic Materials\",\"industry\":\"Building Materials\",\"website\":\"https://www.ultratechcement.com\",\"description\":\"UltraTech Cement Limited, together with its subsidiaries, engages in the manufacturing, marketing, and distribution of building materials in India and internationally. It offers grey cement, including ordinary Portland, composite, and weather plus, as well as Portland pozzolana, pozzolana super, and slag cement; white cement, wall care putty, and value-added products; and ready-mix concrete. The company also provides tile adhesives, gouts, cleaners, and fixing accessories; waterproof coatings, preformed membranes, and repair and integral waterproofing solutions; and ready-mix plasters and industrial and precision grouts. It also provides building solutions and support services; and infrastructure solutions, such as decorative, durability multiplayer, smart repair, advance structural, and floor and slab solutions. The company was formerly known as UltraTech CemCo Limited and changed its name to UltraTech Cement Limited in October 2004. UltraTech Cement Limited was incorporated in 2000 and is based in Mumbai, India. The company operates as a subsidiary of Grasim Industries Limited.\"},\"history\":[{\"timestamp\":1778211900,\"date\":\"2026-05-08T03:45:00.000Z\",\"open\":12090,\"high\":12110,\"low\":11877,\"close\":11950,\"volume\":258727},{\"timestamp\":1778471100,\"date\":\"2026-05-11T03:45:00.000Z\",\"open\":11801,\"high\":11937,\"low\":11773,\"close\":11866,\"volume\":198930},{\"timestamp\":1778557500,\"date\":\"2026-05-12T03:45:00.000Z\",\"open\":11866,\"high\":11866,\"low\":11503,\"close\":11516,\"volume\":343980},{\"timestamp\":1778643900,\"date\":\"2026-05-13T03:45:00.000Z\",\"open\":11500,\"high\":11652,\"low\":11431,\"close\":11573,\"volume\":453482},{\"timestamp\":1778730300,\"date\":\"2026-05-14T03:45:00.000Z\",\"open\":11600,\"high\":11769,\"low\":11550,\"close\":11692,\"volume\":220410},{\"timestamp\":1778816700,\"date\":\"2026-05-15T03:45:00.000Z\",\"open\":11685,\"high\":11730,\"low\":11463,\"close\":11487,\"volume\":284388},{\"timestamp\":1779075900,\"date\":\"2026-05-18T03:45:00.000Z\",\"open\":11447,\"high\":11599,\"low\":11253,\"close\":11561,\"volume\":233668},{\"timestamp\":1779162300,\"date\":\"2026-05-19T03:45:00.000Z\",\"open\":11540,\"high\":11556,\"low\":11347,\"close\":11368,\"volume\":347784},{\"timestamp\":1779248700,\"date\":\"2026-05-20T03:45:00.000Z\",\"open\":11300,\"high\":11430,\"low\":11211,\"close\":11409,\"volume\":168245},{\"timestamp\":1779335100,\"date\":\"2026-05-21T03:45:00.000Z\",\"open\":11484,\"high\":11517,\"low\":11373,\"close\":11474,\"volume\":244967},{\"timestamp\":1779421500,\"date\":\"2026-05-22T03:45:00.000Z\",\"open\":11531,\"high\":11650,\"low\":11511,\"close\":11569,\"volume\":340427},{\"timestamp\":17