{"key":"GET fzazdrzlemmkqngvpzxj.supabase.co/functions/v1/stock-signal-data?symbol=SBIN","page":"/stock-analysis.html?symbol=SBIN","status":200,"type":"application/json","body":"{\"success\":true,\"symbol\":\"SBIN\",\"yahoo_symbol\":\"SBIN.NS\",\"company_name\":\"State Bank of India\",\"exchange\":\"NSI\",\"currency\":\"INR\",\"price\":979,\"previous_close\":970.25,\"previous_close_source\":\"yahoo quote\",\"change\":8.75,\"change_percent\":0.9018294254058232,\"open\":975.0999755859375,\"high\":988,\"low\":968.3499755859375,\"volume\":14878664,\"high_52w\":1234.7,\"low_52w\":933.9,\"fundamentals\":{\"market_cap\":9036774768640,\"pe\":9.992855,\"forward_pe\":9.228804,\"peg_ratio\":0.53,\"price_to_book\":1.5159047,\"book_value\":645.819,\"eps\":97.97,\"dividend_yield\":0.0176,\"dividend_rate\":17.35,\"beta\":0.379,\"profit_margin\":0.22376,\"operating_margin\":0.35717,\"return_on_equity\":0.15177,\"return_on_assets\":0.01132,\"revenue\":3852830244864,\"revenue_per_share\":418.119,\"earnings_growth\":0.099,\"revenue_growth\":0.103,\"gross_profit\":3852830244864,\"free_cash_flow\":null,\"total_cash\":2120133509120,\"total_debt\":8203340349440,\"sector\":\"Financial Services\",\"industry\":\"Banks - Regional\",\"website\":\"https://sbi.bank.in\",\"description\":\"State Bank of India provides banking products and services in India and internationally. The company operates through the Treasury, Corporate/Wholesale Banking, Retail Banking, and Other Banking Business segments. It offers personal banking products and services, including current, savings, salary, and deposit accounts; home, personal, pension, auto, education, and gold loans, as well as loans against insurance property, and securities; debit, business debit, prepaid, and green remit cards; overdrafts; mutual funds, insurance, equity trading, portfolio investment schemes, remittance services; digital lending; and mobile, internet, and digital banking services. The company also provides corporate banking products and services comprising corporate accounts, working capital and project finance, deferred payment guarantees, corporate term loans, structured finance, dealer and channel financing, equipment leasing, loan syndication, construction equipment loans, financing Indian firms' overseas subsidiaries or JVs, and cash management, as well as trade and service products. In addition, it offers NRI services, including accounts, investments, loans, and remittances; agricultural banking services; and international banking services. Further, it provides life and general insurance; estate planning services; merchant banking and advisory; securities broking; trusteeship service; factoring; payment solution; asset management; portfolio and investment management; credit cards; and custody and fund accounting services. State Bank of India was founded in 1806 and is headquartered in Mumbai, India.\"},\"history\":[{\"timestamp\":1778211900,\"date\":\"2026-05-08T03:45:00.000Z\",\"open\":1090,\"high\":1095,\"low\":1010.9000244140625,\"close\":1019.2999877929688,\"volume\":48065909},{\"timestamp\":1778471100,\"date\":\"2026-05-11T03:45:00.000Z\",\"open\":1007,\"high\":1007,\"low\":971.0999755859375,\"close\":973.5999755859375,\"volume\":46927396},{\"timestamp\":1778557500,\"date\":\"2026-05-12T03:45:00.000Z\",\"open\":976.9000244140625,\"high\":981.4000244140625,\"low\":962.4000244140625,\"close\":974.5999755859375,\"volume\":25787092},{\"timestamp\":1778643900,\"date\":\"2026-05-13T03:45:00.000Z\",\"open\":978,\"high\":981.2000122070312,\"low\":961.2000122070312,\"close\":970.0999755859375,\"volume\":17584580},{\"timestamp\":1778730300,\"date\":\"2026-05-14T03:45:00.000Z\",\"open\":973.5,\"high\":987,\"low\":963.5999755859375,\"close\":979.9000244140625,\"volume\":16487142},{\"timestamp\":1778816700,\"date\":\"2026-05-15T03:45:00.000Z\",\"open\":971.2000122070312,\"high\":972.5,\"low\":957,\"close\":963.2000122070312,\"volume\":26972493},{\"timestamp\":1779075900,\"date\":\"2026-05-18T03: