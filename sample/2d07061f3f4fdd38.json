{"key":"GET fzazdrzlemmkqngvpzxj.supabase.co/functions/v1/stock-signal-data?symbol=ASIANPAINT","page":"/stock-analysis.html","status":200,"type":"application/json","body":"{\"success\":true,\"symbol\":\"ASIANPAINT\",\"yahoo_symbol\":\"ASIANPAINT.NS\",\"company_name\":\"Asian Paints Limited\",\"exchange\":\"NSI\",\"currency\":\"INR\",\"price\":2418.3,\"previous_close\":2437.8,\"previous_close_source\":\"yahoo quote\",\"change\":-19.5,\"change_percent\":-0.7999015505783903,\"open\":2425.300048828125,\"high\":2442.60009765625,\"low\":2413.199951171875,\"volume\":1354076,\"high_52w\":2985.7,\"low_52w\":2115,\"fundamentals\":{\"market_cap\":2317854965760,\"pe\":47.92509,\"forward_pe\":40.079674,\"peg_ratio\":null,\"price_to_book\":10.66331,\"book_value\":226.787,\"eps\":50.46,\"dividend_yield\":0.0113,\"dividend_rate\":27.5,\"beta\":0.311,\"profit_margin\":0.12525,\"operating_margin\":0.124630004,\"return_on_equity\":0.23019,\"return_on_assets\":0.112270005,\"revenue\":386321711104,\"revenue_per_share\":403.017,\"earnings_growth\":0.075,\"revenue_growth\":0.169,\"gross_profit\":164668407808,\"free_cash_flow\":14947212288,\"total_cash\":61245800448,\"total_debt\":45957001216,\"sector\":\"Basic Materials\",\"industry\":\"Specialty Chemicals\",\"website\":\"https://www.asianpaints.com\",\"description\":\"Asian Paints Limited, together with its subsidiaries, engages in the manufacture, distribution, and sale of paints, coatings, and products related to home decoration and bath fittings, kitchen, and wardrobe in India, Asia, the Middle East, Africa, and the South Pacific region. The company offers wall coverings, waterproofing products, adhesives; and bath fittings and sanitaryware, modular kitchens and wardrobes, fabric, furnishings, rugs, decorative lightings, unplasticized polyvinyl chloride windows and door systems, furniture, textures and painting aids, and mechanized tools. It also provides color consultancy, projects, home painting services, waterproofing and wood solutions, and assure services; and interior and exterior wall finishes, enamels, tools, undercoats, thinners, and varnishers. The company offers its products under the Asian Paints, SCIB Paints, Apco Coatings, Asian Paints Berger, Taubmans, Asian Paints Causeway, and Kadisco Asian Paints brand names. It serves homeowners, large projects, dealers, corporates, architects, interior designers, contractors, and influencers through multi-channel distribution network comprising wholesalers, distributors, retail outlets, and e-commerce platforms. Asian Paints Limited was founded in 1942 and is headquartered in Mumbai, India.\"},\"history\":[{\"timestamp\":1778211900,\"date\":\"2026-05-08T03:45:00.000Z\",\"open\":2540,\"high\":2607.39990234375,\"low\":2515.39990234375,\"close\":2599.89990234375,\"volume\":2327900},{\"timestamp\":1778471100,\"date\":\"2026-05-11T03:45:00.000Z\",\"open\":2578.89990234375,\"high\":2607.89990234375,\"low\":2555,\"close\":2566.10009765625,\"volume\":1271257},{\"timestamp\":1778557500,\"date\":\"2026-05-12T03:45:00.000Z\",\"open\":2546.199951171875,\"high\":2555.699951171875,\"low\":2500,\"close\":2505.5,\"volume\":628802},{\"timestamp\":1778643900,\"date\":\"2026-05-13T03:45:00.000Z\",\"open\":2554,\"high\":2642.39990234375,\"low\":2554,\"close\":2617.60009765625,\"volume\":3515018},{\"timestamp\":1778730300,\"date\":\"2026-05-14T03:45:00.000Z\",\"open\":2620,\"high\":2665.699951171875,\"low\":2610,\"close\":2622.199951171875,\"volume\":1040916},{\"timestamp\":1778816700,\"date\":\"2026-05-15T03:45:00.000Z\",\"open\":2622.199951171875,\"high\":2640,\"low\":2592.800048828125,\"close\":2605.60009765625,\"volume\":796240},{\"timestamp\":1779075900,\"date\":\"2026-05-18T03:45:00.000Z\",\"open\":2580.10009765625,\"high\":2619.39990234375,\"low\":2556,\"close\":2614,\"volume\":898479},{\"timestamp\":1779162300,\"date\":\"2026-05-19T03:45:00.000Z\",\"open\":2629,\"high\":2646,\"low\":2595.10009765625,\"close\":2600.699951171875,\"volume\":688639},{\"timest