{"key":"GET fzazdrzlemmkqngvpzxj.supabase.co/functions/v1/stock-signal-data?symbol=MAXHEALTH","page":"/stock-analysis.html","status":200,"type":"application/json","body":"{\"success\":true,\"symbol\":\"MAXHEALTH\",\"yahoo_symbol\":\"MAXHEALTH.NS\",\"company_name\":\"Max Healthcare Institute Limited\",\"exchange\":\"NSI\",\"currency\":\"INR\",\"price\":927.15,\"previous_close\":895.5,\"previous_close_source\":\"yahoo quote\",\"change\":31.649999999999977,\"change_percent\":3.534338358458959,\"open\":895,\"high\":927.1500244140625,\"low\":890.9500122070312,\"volume\":4011273,\"high_52w\":1185.4,\"low_52w\":797,\"fundamentals\":{\"market_cap\":902420168704,\"pe\":65.615715,\"forward_pe\":40.09495,\"peg_ratio\":null,\"price_to_book\":7.9692454,\"book_value\":116.341,\"eps\":14.13,\"dividend_yield\":0.0022,\"dividend_rate\":2,\"beta\":0.182,\"profit_margin\":0.15095,\"operating_margin\":0.22336,\"return_on_equity\":0.12791,\"return_on_assets\":0.06977,\"revenue\":91457896448,\"revenue_per_share\":94.023,\"earnings_growth\":-0.155,\"revenue_growth\":0.203,\"gross_profit\":57689899008,\"free_cash_flow\":2001449984,\"total_cash\":5709599744,\"total_debt\":37950300160,\"sector\":\"Healthcare\",\"industry\":\"Medical Care Facilities\",\"website\":\"https://www.maxhealthcare.in\",\"description\":\"Max Healthcare Institute Limited provides medical and healthcare services in India. It offers services in various specialties, including cardiac sciences, orthopedics, oncology, renal sciences, neurosciences, minimal access and general surgery, pulmonology, obstetrics, bone marrow transplant, bariatric/weight loss surgery, gynecology, minimal access/laparoscopic surgery, eye care/ophthalmology, robotic surgery, paediatrics, nephrology, liver and biliary sciences, gastroenterology and GI surgery, internal medicine, organ transplants, and plastic and reconstructive surgery. The company also provides Max@Home, a platform that offers health and wellness services at home; and Max Lab, which provides diagnostic testing services to patients. In addition, it offers organ and tissue donation, preventive health checks, ambulance and immigration, air ambulance, and insurance and TPA services. The company provides healthcare services through a network of primary care clinics, multi-specialty hospitals/medical centres, and super-specialty hospital facilities. Max Healthcare Institute Limited was incorporated in 2001 and is based in Gurugram, India.\"},\"history\":[{\"timestamp\":1778211900,\"date\":\"2026-05-08T03:45:00.000Z\",\"open\":1013.5999755859375,\"high\":1024.5999755859375,\"low\":1007.4000244140625,\"close\":1012.5,\"volume\":1835293},{\"timestamp\":1778471100,\"date\":\"2026-05-11T03:45:00.000Z\",\"open\":1012.5,\"high\":1041.800048828125,\"low\":1003.8499755859375,\"close\":1037.949951171875,\"volume\":3043486},{\"timestamp\":1778557500,\"date\":\"2026-05-12T03:45:00.000Z\",\"open\":1040.300048828125,\"high\":1046,\"low\":1014,\"close\":1017.7000122070312,\"volume\":1891443},{\"timestamp\":1778643900,\"date\":\"2026-05-13T03:45:00.000Z\",\"open\":1009.2999877929688,\"high\":1032.75,\"low\":1003.5499877929688,\"close\":1026.0999755859375,\"volume\":1056295},{\"timestamp\":1778730300,\"date\":\"2026-05-14T03:45:00.000Z\",\"open\":1025.199951171875,\"high\":1057.699951171875,\"low\":1025.1500244140625,\"close\":1049.550048828125,\"volume\":1822137},{\"timestamp\":1778816700,\"date\":\"2026-05-15T03:45:00.000Z\",\"open\":1049.550048828125,\"high\":1059.9000244140625,\"low\":1042.4000244140625,\"close\":1050.0999755859375,\"volume\":1471140},{\"timestamp\":1779075900,\"date\":\"2026-05-18T03:45:00.000Z\",\"open\":1040,\"high\":1063,\"low\":1024.300048828125,\"close\":1058.550048828125,\"volume\":1558086},{\"timestamp\":1779162300,\"date\":\"2026-05-19T03:45:00.000Z\",\"open\":1061.5999755859375,\"high\":1080,\"low\":1054.6500244140625,\"close\":1068.75,\"volume\":2102863},{\"timestamp\":1779248700,\"date\":\"2026-05-20T03:45:00.000Z\",\"open\":1060.0